LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# OpenAI-compatible SenseVoice service, for example http://127.0.0.1:8001
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=sensevoice
# Development: sqlite:///./data/study_diary.db
# Render + Supabase: copy the Session pooler URI (port 5432) and append
# ?sslmode=require. postgres:// and postgresql:// are converted to psycopg.
DATABASE_URL=sqlite:///./data/study_diary.db
# Calendar-day statistics and daily recommendations use this timezone.
APP_TIMEZONE=Asia/Shanghai
# Multiple trusted origins are comma separated. Never use * with credentials.
FRONTEND_ORIGIN=http://127.0.0.1:5173
DESKTOP_PET_ORIGINS=http://127.0.0.1:1420,http://tauri.localhost
# Supabase Auth project URL, public publishable key, and server-only service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Verified Supabase Auth user UUID for the sole administrator.
ADMIN_USER_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:study-diary@example.com
REMINDER_CRON_SECRET=
AI_RATE_LIMIT_PER_MINUTE=12
ALLOW_QUESTION_REVIEW=false
ALLOW_UNVERIFIED_QUESTION_ACCESS=false
ALLOW_AI_QUESTION_REVIEW=false
ALLOW_QUESTION_QUICK_PUBLISH=false
BATCH_AI_REVIEW_CONCURRENCY=2
