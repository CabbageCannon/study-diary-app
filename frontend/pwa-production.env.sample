# Copy to frontend/.env.production before building the production web bundle.
# A same-origin reverse proxy avoids cross-origin browser configuration on
# iPhone Safari. API callers already include the /api path, so this must stay
# empty; setting it to /api would produce /api/api/... requests.
VITE_API_BASE_URL=
VITE_ENABLE_QUESTION_REVIEW=false
VITE_ENABLE_AI_QUESTION_REVIEW=false
VITE_ENABLE_QUESTION_QUICK_PUBLISH=false
